# Copy to .env and supply real values outside source control.
HF_TOKEN=
GEMINI_API_KEY=
INTERNAL_TOKEN=replace-with-a-long-random-value
OBJECT_STORE_BUCKET=artifacts
OBJECT_STORE_ACCESS_KEY=webutils
OBJECT_STORE_SECRET_KEY=change-me-in-production
ARTIFACT_TTL=1h
RETENTION_WINDOW=168h
WHISPER_MODEL_PATH=/models/ggml-base.en.bin
# Set FAKE_PIPELINE=false in production when real Whisper model, HF_TOKEN, and GEMINI_API_KEY are mounted.
FAKE_PIPELINE=true
